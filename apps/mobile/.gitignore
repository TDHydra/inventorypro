# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
# EAS local credentials — holds keystore path + passwords, never commit
credentials.json
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Sentry (#213) — auth-token file for source-map/ProGuard upload, opt-in
# later; v1 ships without it. sentry.properties would already fall under the
# /ios and /android ignores above once those dirs exist, but listed
# explicitly in case either path is ever tracked outside a generated folder.
.env.sentry-build-plugin
android/sentry.properties
ios/sentry.properties
