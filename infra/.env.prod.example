# ───────────────────────────────────────────────────────────────────────────
# InventoryPro production env — copy to `.env` next to docker-compose.prod.yml
# and fill in. Replace plexcontrol.com with your domain.
# ───────────────────────────────────────────────────────────────────────────

# ── Postgres (internal only — never exposed to the host) ──
POSTGRES_DB=inventorypro
POSTGRES_USER=inventorypro
POSTGRES_PASSWORD=CHANGE_ME_long_random_db_password

# ── MinIO object storage ──
MINIO_ROOT_USER=inventorypro
MINIO_ROOT_PASSWORD=CHANGE_ME_long_random_minio_password
MINIO_BUCKET=inventorypro-media

# ── API auth secret (generate: openssl rand -base64 64) ──
JWT_SECRET=CHANGE_ME_generate_a_64_char_random_secret

# ── Public URLs (these are what NPM serves; must be https) ──
# The MinIO S3 endpoint the mobile app uploads to + downloads from.
MINIO_PUBLIC_ENDPOINT=https://s3.plexcontrol.com
# Where uploaded media is served from (S3 endpoint + bucket, path-style):
PUBLIC_MEDIA_URL=https://s3.plexcontrol.com/inventorypro-media
# Optional: MinIO admin console public URL (only if you proxy the console).
MINIO_CONSOLE_URL=https://minio.plexcontrol.com

# ── Web app (Expo Web static build) ──
# API base URL baked into the web bundle at build time (rebuild --build to change).
EXPO_PUBLIC_API_URL=https://api.plexcontrol.com

# ── Host ports NPM points at (change if they clash with other Unraid apps) ──
# These are HOST ports only — the containers still listen on their internal
# ports (api=3000, minio=9000/9001). Point each NPM proxy host at the value here.
# 3000 collides with several Unraid apps; 3100 is a safer default.
API_PORT=3100
WEB_PORT=8088
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Container image ──
# Default builds from the repo. To use a prebuilt image, set this and drop the
# `build:` block (or run without --build):
# API_IMAGE=ghcr.io/youruser/inventorypro-api:latest
API_IMAGE=inventorypro-api:latest
WEB_IMAGE=inventorypro-web:latest
