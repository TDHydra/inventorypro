# Postgres
POSTGRES_DB=inventorypro
POSTGRES_USER=inventorypro
POSTGRES_PASSWORD=change_me_strong_password

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET=inventorypro-media

# API
JWT_SECRET=change_me_very_long_random_secret_at_least_64_chars
PUBLIC_MEDIA_URL=https://yourdomain.com/media

# Browser CORS allowlist (comma-separated web origins)
CORS_ORIGINS=http://localhost:8088
# Trusted proxy subnet(s) for correct client IPs behind nginx (empty = off)
TRUST_PROXY=

# Outbound mail (SMTP) — all of HOST/USER/PASS/FROM required or mail is a
# logged no-op. Port 465 = implicit TLS, anything else = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Inventory Pro <you@example.com>

# Web app — API base URL baked into the web bundle at build time
EXPO_PUBLIC_API_URL=http://localhost:3000
WEB_PORT=8088

# Set in .env (copy this file to .env and fill in values)
