# InventoryPro web (lean-rebuild) — builds the mobile-v2 Expo Web static export
# and serves it with the same nginx config as the old web image.
#
# Phase 9: selected on the VPS via WEB_DOCKERFILE in /opt/inventorypro/.env
# (compose defaults to the old infra/Dockerfile.web). Rollback = retag the
# previous inventorypro-web image and recreate — the API URL/CSP story is
# unchanged, so the two bundles are drop-in swappable behind host nginx.
#
# The API base URL is baked into the static bundle at BUILD time (Expo inlines
# EXPO_PUBLIC_* at export), so it's an ARG, not a runtime env.

FROM node:20-alpine AS builder
WORKDIR /app
RUN npm install -g pnpm

# Baked into the static bundle — where the web app calls the API.
ARG EXPO_PUBLIC_API_URL=https://api.invenpro.app
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL

# Workspace-aware install (root lockfile): mobile-v2 + its workspace deps
# (@invenpro/core, @invenpro/ui — consumed as TS source, so their manifests
# must be present for the filter to resolve them).
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/mobile-v2/package.json ./apps/mobile-v2/
COPY packages/core/package.json ./packages/core/
COPY packages/ui/package.json ./packages/ui/
RUN pnpm install --frozen-lockfile --filter mobile-v2...

# Build the web bundle → apps/mobile-v2/dist (Metro bundles the workspace
# packages straight from src/, same as dev).
COPY packages/core ./packages/core
COPY packages/ui ./packages/ui
COPY apps/mobile-v2 ./apps/mobile-v2
RUN cd apps/mobile-v2 && npx expo export -p web

# sql.js browser WASM must be reachable at the web root. expo export copies
# public/ into dist/, but copy it explicitly as a guard (this build's sql.js
# glue fetches sql-wasm-browser.wasm, NOT sql-wasm.wasm).
RUN cp -f apps/mobile-v2/node_modules/sql.js/dist/sql-wasm-browser.wasm \
        apps/mobile-v2/dist/sql-wasm-browser.wasm

# Do NOT ship JS source maps to production (they leak client logic/schema).
RUN find apps/mobile-v2/dist -name '*.map' -type f -delete

# --- Serve ---
FROM nginx:alpine AS runner
COPY infra/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/mobile-v2/dist /usr/share/nginx/html
EXPOSE 80
