# InventoryPro self-host env — cp .env.example .env, then edit the CHANGE_ME
# values. Used by the root docker-compose.yml. PLACEHOLDERS ONLY — never commit
# real secrets.

# ── Postgres ──
POSTGRES_DB=inventorypro
POSTGRES_USER=inventorypro
POSTGRES_PASSWORD=CHANGE_ME_long_random_db_password

# DATABASE_URL is composed automatically by docker-compose.yml from the
# POSTGRES_* values above. Only set it yourself when running the all-in-one
# image against an EXTERNAL Postgres (the bundled one needs no URL):
# DATABASE_URL=postgresql://inventorypro:CHANGE_ME@your-db-host:5432/inventorypro

# ── API auth secret (generate: openssl rand -base64 64) ──
JWT_SECRET=CHANGE_ME_generate_a_64_char_random_secret

# ── MinIO (media storage) ──
# The root credentials are mapped by compose to the API's MINIO_ACCESS_KEY /
# MINIO_SECRET_KEY — media endpoints fail closed if those are unset.
MINIO_ROOT_USER=inventorypro
MINIO_ROOT_PASSWORD=CHANGE_ME_long_random_minio_password
MINIO_BUCKET=inventorypro-media
# Public S3 endpoint baked into device-facing signed upload URLs (what phones/
# browsers can reach — NOT http://minio:9000). LAN example:
MINIO_PUBLIC_ENDPOINT=http://192.168.1.100:9000
# Where uploaded media is served from (public S3 endpoint + bucket, path-style):
PUBLIC_MEDIA_URL=http://192.168.1.100:9000/inventorypro-media

# ── API behind a reverse proxy ──
# Browser CORS allowlist (comma-separated web origins). Must include the web
# app's origin or the browser blocks API calls.
CORS_ORIGINS=http://localhost:8088
# Trusted proxy subnet(s) for correct client IPs behind a reverse proxy
# (leave empty when not proxied), e.g. 172.16.0.0/12
TRUST_PROXY=

# ── Outbound mail (SMTP) — all of HOST/USER/PASS/FROM required or mail is a
# logged no-op. Port 465 = implicit TLS, anything else = STARTTLS. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Inventory Pro <you@example.com>

# ── Web app ──
# API base URL baked into the web bundle at BUILD time — rebuild with --build
# after changing. Use a URL reachable from the browser's machine.
EXPO_PUBLIC_API_URL=http://localhost:3000

# ── Host ports ──
API_PORT=3000
WEB_PORT=8088
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
