# Dependencies
node_modules/
.pnpm-store/

# Expo / React Native native projects (regenerated via `expo prebuild`)
legacy-v1/mobile/android/
legacy-v1/mobile/ios/
legacy-v1/mobile/.expo/

# Build output
apps/api-v2/dist/
legacy-v1/api/dist/

# Large artifacts (image tarballs + APKs are shipped out-of-band, never committed —
# a stray 124MB APK in a commit exceeds GitHub's 100MB limit and bloats history)
*.tar.gz
*.apk

# Signing / credentials — never committed (previously only in .git/info/exclude
# or legacy-v1/mobile/.gitignore, which don't cover new app packages)
*.jks
*.pass
credentials.json

# Env files (keep the *.example ones)
**/.env
**/.env.local
**/.env.prod

# Logs / OS cruft
*.log
.DS_Store

# Python bytecode cache
__pycache__/
*.pyc

# This is a pnpm workspace — npm / `expo install` can spuriously regenerate this.
package-lock.json

# SDD process scratch (briefs, reports, ledger)
.superpowers/
google-services.json
*-adminsdk-*.json
*.tar.gz
