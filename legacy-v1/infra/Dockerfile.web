# InventoryPro web — builds the Expo Web static export and serves it with nginx.
# Fronted by Nginx Proxy Manager (NPM): frontend.plexcontrol.com -> :${WEB_PORT}.
#
# The API base URL is baked into the static bundle at BUILD time (Expo inlines
# EXPO_PUBLIC_* at export), so it's an ARG, not a runtime env.

FROM node:20-alpine AS builder
WORKDIR /app
RUN npm install -g pnpm

# Baked into the static bundle — where the web app calls the API.
ARG EXPO_PUBLIC_API_URL=https://api.plexcontrol.com
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL

# Workspace-aware install (uses the root lockfile), mobile + its deps only.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY legacy-v1/mobile/package.json ./legacy-v1/mobile/
RUN pnpm install --frozen-lockfile --filter mobile...

# Build the web bundle → legacy-v1/mobile/dist
COPY legacy-v1/mobile ./legacy-v1/mobile
RUN cd legacy-v1/mobile && npx expo export -p web

# sql.js browser WASM must be reachable at the web root. expo export copies
# public/ into dist/, but copy it explicitly as a guard (this build's sql.js
# glue fetches sql-wasm-browser.wasm, NOT sql-wasm.wasm).
RUN cp -f legacy-v1/mobile/node_modules/sql.js/dist/sql-wasm-browser.wasm \
        legacy-v1/mobile/dist/sql-wasm-browser.wasm

# Do NOT ship JS source maps to production (they leak client logic/schema).
# `expo export` can emit *.map files alongside the bundles; strip them from the
# served dist before the runner stage copies it. Deleting is authoritative and
# independent of any export flag. Verify: `curl -sI https://<host>/_expo/...js.map`
# returns 404 and `find dist -name '*.map'` is empty in the image.
RUN find legacy-v1/mobile/dist -name '*.map' -type f -delete

# --- Serve ---
FROM nginx:alpine AS runner
COPY infra/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/legacy-v1/mobile/dist /usr/share/nginx/html
EXPOSE 80
